rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ["izabella.szlovak92@gmail.com", "varhidibence93@gmail.com"];
    }

    match /termek-kepek/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
